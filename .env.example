# 清浅 Wiki 环境变量示例
# 用法：复制为 .env 后填写（本地开发与 Docker 部署通用）
# 标记：[必填] 缺失会导致核心功能不可用；[可选] 留空使用默认值

# ============================================================
# 核心
# ============================================================

# [必填] PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/qingqian_wiki"

# [必填] JWT 签名密钥，至少 32 字符（生产环境缺失或过短会拒绝启动）
JWT_SECRET=""

# [可选] 服务监听端口，默认 3103
PORT="3103"

# [可选] 上传根目录，留空时使用 <项目目录>/uploads
UPLOADS_PATH=""

# [可选] bcrypt 代价因子，默认 12
BCRYPT_SALT_ROUNDS="12"

# [可选] Prisma 连接池上限，默认按 CPU 核数自动计算
DB_CONNECTION_LIMIT=""

# [可选] 连接池等待超时（秒），默认 10
DB_POOL_TIMEOUT=""

# [可选] 集成测试详细日志开关：设为 1 时打印测试期日志
DEBUG_INTEGRATION=""

# [可选] 强制认证 Cookie 的 secure 属性：true / false；留空按请求协议判断
COOKIE_SECURE=""

# [可选] 站点公开根 URL（如 https://wiki.example.com），用于日志与链接拼接
PUBLIC_SITE_URL=""

# [可选] 仅开发环境生效：设为 true 时关闭接口限流（本地联调/自动化验证用）
DEV_DISABLE_RATE_LIMIT="false"

# ============================================================
# 图片处理（sharp）
# ============================================================

# [可选] libvips 工作线程并发数，默认 1（小内存部署保持 1）
SHARP_CONCURRENCY="1"

# [可选] 允许解码的最大像素数，默认 25000000（约 5000x5000），用于防御像素炸弹
SHARP_MAX_INPUT_PIXELS="25000000"

# ============================================================
# 对象存储（可选）：以下 S3_* 全部填写后才可在后台切换到对象存储
# ============================================================

# [可选] S3 兼容服务端点，如 https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# [可选] 区域，如 auto / us-east-1
S3_REGION=""
# [可选] 存储桶名
S3_BUCKET=""
# [可选] 访问密钥
S3_ACCESS_KEY_ID=""
# [可选] 访问密钥 Secret
S3_SECRET_ACCESS_KEY=""
# [可选] 图片公开访问前缀（自定义域名或桶公网地址）
S3_PUBLIC_BASE_URL=""
# [可选] 对象 key 前缀，默认 qingqian
S3_PREFIX="qingqian"
# [可选] MinIO 等需要 path-style 时设为 true
S3_FORCE_PATH_STYLE="false"

# ============================================================
# Docker Compose 参数（本地开发不需要）
# ============================================================

POSTGRES_USER="qingqian"
POSTGRES_PASSWORD=""
POSTGRES_DB="qingqian_wiki"
APP_PORT="3103"
APP_MEM_LIMIT="512m"
