{
  "name": "qingqian-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "清浅 Wiki：美图与键帽档案站",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit",
    "format": "prettier --write . --log-level warn",
    "test": "NODE_ENV=test vitest run --reporter=dot",
    "test:unit": "NODE_ENV=test vitest run --project unit-node --project unit-jsdom --reporter=dot --silent=passed-only",
    "test:integration": "NODE_ENV=test vitest run --config vitest.integration.config.ts --reporter=dot --silent=passed-only",
    "test:db:init": "tsx scripts/test-db-init.ts",
    "verify": "npm run lint && npm run test:unit && npm run test:integration && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "bcryptjs": "^2.4.3",
    "blurhash": "^2.0.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.546.0",
    "prettier": "^3.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^7.18.1",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "terser": "^5.51.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
